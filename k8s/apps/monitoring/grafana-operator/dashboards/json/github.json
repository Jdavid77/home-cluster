    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "orange", "value": 14 },
              { "color": "red", "value": 30 }
            ]
          },
          "unit": "d"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Branch" },
            "properties": [{ "id": "custom.width", "value": 340 }]
          },
          {
            "matcher": { "id": "byName", "options": "Age (days)" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              {
                "id": "custom.cellOptions",
                "value": { "mode": "gradient", "type": "color-background" }
